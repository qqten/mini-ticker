{
  "name": "mini-ticker",
  "version": "1.0.5",
  "description": "背景透明的极简桌面盯盘浮窗：只有红绿折线和数值",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/launch.js",
    "dist": "electron-builder --win",
    "pack:dir": "electron-builder --win --dir"
  },
  "keywords": [
    "electron",
    "desktop-widget",
    "stock-ticker",
    "transparent-window",
    "a-share",
    "fund"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.miniticker.watch",
    "productName": "MiniTicker",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "settings/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/autostart.ps1",
        "to": "scripts/autostart.ps1"
      }
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Mini Ticker",
      "artifactName": "MiniTicker-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "qqten",
        "repo": "mini-ticker"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
